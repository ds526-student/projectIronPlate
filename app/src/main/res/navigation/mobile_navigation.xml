<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.projectironplate.ui.dashboard.DashboardFragment"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_food"
        android:name="com.example.projectironplate.ui.food.FoodFragment"
        tools:layout="@layout/fragment_food" />

    <fragment
        android:id="@+id/navigation_workouts"
        android:name="com.example.projectironplate.ui.workouts.WorkoutsFragment"
        tools:layout="@layout/fragment_workouts" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.projectironplate.ui.profile.ProfileFragment"
        tools:layout="@layout/fragment_profile" />
</navigation>