<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="15dp"
    android:layout_marginVertical="25dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/card_background_rounded"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protein"
                android:textSize="@dimen/reg_text"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="5dp"/>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">


                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/protein_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:indicatorSize="100dp"
                    app:trackThickness="8dp"
                    app:indicatorColor="@color/protein"
                    app:trackColor="@color/border"
                    app:indicatorDirectionCircular="clockwise"
                    app:indicatorInset="0dp"
                    app:hideAnimationBehavior="none"
                    android:indeterminate="false"
                    android:progress="50"
                    android:layout_margin="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_remaining_protein"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/title_text"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"/>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Remaining"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:gravity="center"/>
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fat"
                android:textSize="@dimen/reg_text"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="5dp"/>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/fat_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:indicatorSize="100dp"
                    app:trackThickness="8dp"
                    app:indicatorColor="@color/fats"
                    app:trackColor="@color/border"
                    app:indicatorDirectionCircular="clockwise"
                    app:indicatorInset="0dp"
                    app:hideAnimationBehavior="none"
                    android:indeterminate="false"
                    android:progress="50"
                    android:layout_margin="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_remaining_fat"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/title_text"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"/>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Remaining"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:gravity="center"/>
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carbs"
                android:textSize="@dimen/reg_text"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="5dp"/>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/carbs_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:indicatorSize="100dp"
                    app:trackThickness="8dp"
                    app:indicatorColor="@color/carbs"
                    app:trackColor="@color/border"
                    app:indicatorDirectionCircular="clockwise"
                    app:indicatorInset="0dp"
                    app:hideAnimationBehavior="none"
                    android:indeterminate="false"
                    android:progress="50"
                    android:layout_margin="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_remaining_carbs"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/title_text"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"/>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Remaining"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:gravity="center"/>
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>